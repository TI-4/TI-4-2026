# =============================================================================
# UCT Map - Variables de Entorno y Configuración de API / Backend
# =============================================================================
# Modifica estas variables según el entorno en el que estés ejecutando la app.
#
# Entornos disponibles:
#   - development (desarrollo local / emuladores)
#   - staging (pruebas e integración continua)
#   - production (despliegue productivo)
# =============================================================================

APP_ENV=development

# -----------------------------------------------------------------------------
# URL Base del API Gateway
# -----------------------------------------------------------------------------
# - En navegador Web o escritorio Linux: http://localhost:5052
# - En emulador oficial de Android:      http://10.0.2.2:5052
# - En dispositivo físico / Wi-Fi local: http://<IP_DE_TU_PC>:5052
# -----------------------------------------------------------------------------
API_BASE_URL=http://localhost:5052

# Tiempo límite para peticiones HTTP en segundos (por defecto 15)
API_TIMEOUT_SECONDS=15

# Credenciales de API (si el Gateway o servicio requiere Header con clave)
API_KEY=
API_SECRET=

# -----------------------------------------------------------------------------
# URLs directas de microservicios (Opcional: solo si no se usa Gateway)
# -----------------------------------------------------------------------------
IDENTITY_SERVICE_URL=
CAMPUS_SERVICE_URL=
SCHEDULE_SERVICE_URL=
INCIDENT_SERVICE_URL=

# -----------------------------------------------------------------------------
# Servicios de Mapas y Cartografía
# -----------------------------------------------------------------------------
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
