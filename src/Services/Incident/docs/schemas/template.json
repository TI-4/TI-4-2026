{
  "incident_object": {
    "_id": {"type": "ObjectId"},
    "title": {"type": "string"},
    "description": {"type": "string"},
    "status": {
      "type": "string",
      "enum": ["Pending", "In_Process", "Resolved", "Canceled"]
    },
    "photo_url": {"type": "string", "format": "uri"}
  },

  "incident_ticket": {
    "_id": {"type": "ObjectId"},
    "object_id": {"type": "ObjectId", "description": "Reference to incident_object"},
    "user_id": {"type": "UUID", "description": "Reference to Identity DB"},
    "structure_id": {"type": "UUID", "description": "Reference to Campus DB"},

    "ticket_type": {
      "type": "string",
      "enum": ["Claim", "Found", "Match", "Pickup"]
    },
    "is_active": {"type": "bool"},
    "date": {"type": "string", "format": "date-time"},

    "location": {
      "type": {"type": "string", "enum": ["Point"]},
      "coordinates": {"type": "array", "items": "number", "description": "[longitude, latitude]"}
    }
  }
}
