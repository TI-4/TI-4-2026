{
  "incident_object": {
    "_id": {"type": "ObjectId"},
    "title": {"type": "string"},
    "description": {"type": "string"},
    "status": {
      "type": "string",
      "enum": ["Pending", "In_Process", "Resolved", "Canceled"]
    },
    "photo_url": {"type": "string", "format": "uri"}
  },
  "incident_ticket": {
    "_id": {"type": "ObjectId"},
    "user_id": {"type": "UUID"},
    "structure_id": {"type": "UUID"},
    "ticket_type": {
      "type": "string",
      "enum": ["Claim", "Found", "Match", "Pickup"]
    },
    "is_active": {"type": "bool"},
    "date_ticket": {"type": "string", "format": "date-time"},
    "location": {
      "type": {"type": "string", "enum": ["Point"]},
      "coordinates": {"type": "array", "items": "number"}
    },
    "object_id": {
      "type": "ObjectId",
      "optional": true,
      "description": "Reference to an independent incident_object"
    },
    "complaint_details": {
      "type": "object",
      "optional": true,
      "properties": {
        "title": {"type": "string"},
        "description": {"type": "string"},
        "status": {
          "type": "string",
          "enum": ["Pending", "In_Process", "Resolved", "Dismissed"]
        }
      }
    }
  }
}
